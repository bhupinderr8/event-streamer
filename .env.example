# ─── Server (cmd/server) ───
PORT=:50051
ADMIN_PORT=:8080
REDIS_ADDR=127.0.0.1:6379
KAFKA_BROKERS=127.0.0.1:9092
DLQ_PATH=dlq.log
RATE_LIMIT=100000
LEASE_BATCH_SIZE=2000
LOG_LEVEL=info
GOMEMLIMIT=1500MiB

# ─── Consumer (cmd/consumer) ───
DATABASE_URL=postgres://user:password@127.0.0.1:5432/events_db?sslmode=disable
KAFKA_TOPIC=events
KAFKA_GROUP_ID=event-streamer-consumers
BATCH_SIZE=1000
BATCH_TIMEOUT_MS=50

